{
  "name": "intent-harness",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "turbo run dev",
    "check": "turbo run lint typecheck test boundaries build && pnpm contract:check && pnpm workflow:check",
    "lint": "turbo run lint",
    "format": "biome check --write . && turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "contract": "turbo run generate",
    "contract:check": "sh scripts/check-contract.sh",
    "workflow:check": "sh scripts/workflow-check.sh",
    "docs:check": "python3 scripts/check_docs.py",
    "readiness": "python3 scripts/readiness.py",
    "e2e": "turbo run e2e",
    "docker:smoke": "sh scripts/docker-smoke.sh",
    "eval": "pnpm --filter @intent-harness/api run eval"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.7"
  }
}
