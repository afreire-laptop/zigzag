# zigzag configuration. On a fresh checkout, copy to .env; to upgrade an existing .env, edit it in place
# (see "Upgrading an existing .env" in README.md). Only ZIGZAG_* variables are read.
# Empty values mean "use the default". Unknown ZIGZAG_* names stop startup, so typos cannot pass silently.

# "fixture" (default) serves canned journey responses from fixtures/journeys.json and makes no network calls.
# "live" calls OpenRouter and needs the key and model below.
ZIGZAG_MODEL_MODE=fixture

# --- Live mode only -------------------------------------------------------------------------------
# An OpenRouter API key. It stays on the server and is never sent to the browser.
ZIGZAG_OPENROUTER_API_KEY=
# An explicit OpenRouter model slug that supports structured outputs, e.g. provider/model-name.
ZIGZAG_MODEL=
# low | medium | high, or empty to use the model's default.
ZIGZAG_REASONING_EFFORT=

# --- Limits (defaults shown) -----------------------------------------------------------------------
# ZIGZAG_MAX_OUTPUT_TOKENS=16000
# ZIGZAG_ATTEMPT_TIMEOUT_SECONDS=90
# Total time for one assessment, including retries and time spent queued.
# ZIGZAG_DEADLINE_SECONDS=180
# Attempts per assessment for failures known not to have reached the model: no connection, or an OpenRouter 429 or
# 503 rejection. A request that may have reached the model, for example after a timeout once it was sent, is never
# repeated automatically, because it may still be processed and charged. You decide whether to retry.
# ZIGZAG_MAX_ATTEMPTS=2
# ZIGZAG_MAX_CONCURRENT_OPERATIONS=2
